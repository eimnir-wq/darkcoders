# ------------------------------------------------------------------
# Dark Coders — Environment configuration
# Copy to `.env.local` and adjust. NEVER commit real secrets.
# ------------------------------------------------------------------

# Public base URL (used for SEO metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:5555

# Application port (the app runs on 5555 by default)
PORT=5555

# Node environment
NODE_ENV=development

# ------------------------------------------------------------------
# Optional / future integrations (leave empty to use mock services)
# ------------------------------------------------------------------

# PostgreSQL connection string (Prisma / future persistence layer)
DATABASE_URL=

# Auth.js / enterprise SSO (Keycloak, Entra ID, Okta)
AUTH_SECRET=
AUTH_KEYCLOAK_ISSUER=
AUTH_KEYCLOAK_CLIENT_ID=
AUTH_KEYCLOAK_CLIENT_SECRET=

# Threat intelligence / SIEM / SOAR / search integrations
SIEM_OPENSEARCH_URL=
SIEM_OPENSEARCH_API_KEY=
SOAR_WEBHOOK_URL=
THREAT_FEED_API_KEY=

# Object storage for evidence and artifacts
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# External AI provider (the copilot falls back to the local mock engine)
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=

# Rate limiting abstraction
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
